# Copier en .env (exclu du dépôt) et remplacer chaque valeur.

# PostgreSQL (docker-compose.dev.yml)
POSTGRES_DB=cseforms
POSTGRES_USER=cseforms
POSTGRES_PASSWORD=a-remplacer
POSTGRES_PORT=5432

# Chaîne de connexion lue par l'API, le Worker et dotnet ef
ConnectionStrings__Default=Host=localhost;Port=5432;Database=cseforms;Username=cseforms;Password=a-remplacer

# Tests d'intégration : rôle autorisé à créer des bases jetables
CSEFORMS_TEST_POSTGRES=Host=localhost;Port=5432;Database=postgres;Username=cseforms;Password=a-remplacer

# Réseaux du proxy (Traefik) autorisés à transmettre X-Forwarded-For, en CIDR séparés par des virgules
ReverseProxy__KnownNetworks=172.16.0.0/12

# Limitation de débit par IP sur l'API publique (valeurs par défaut si absentes)
RateLimiting__PublicSubmit__PermitLimit=30
RateLimiting__PublicSubmit__WindowSeconds=600
RateLimiting__PublicRead__PermitLimit=120
RateLimiting__PublicRead__WindowSeconds=60
