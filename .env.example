# Copier en .env (exclu du dépôt) et remplacer chaque valeur.

# PostgreSQL (docker-compose.dev.yml)
POSTGRES_DB=cseforms
POSTGRES_USER=cseforms
POSTGRES_PASSWORD=a-remplacer
POSTGRES_PORT=5432

# Chaîne de connexion lue par l'API, le Worker et dotnet ef
# Guillemets obligatoires : sans eux, `. ./.env` coupe la valeur au premier point-virgule.
ConnectionStrings__Default='Host=localhost;Port=5432;Database=cseforms;Username=cseforms;Password=a-remplacer'

# Tests d'intégration : rôle autorisé à créer des bases jetables
CSEFORMS_TEST_POSTGRES='Host=localhost;Port=5432;Database=postgres;Username=cseforms;Password=a-remplacer'

# Adresse(s) du reverse proxy autorisée(s) à transmettre X-Forwarded-For/Proto, en CIDR séparés par des virgules
# (IP du proxy telle que vue par l'API ; vide = en-têtes ignorés)
ReverseProxy__KnownNetworks=192.0.2.10/32

# Limitation de débit par IP sur l'API publique (valeurs par défaut si absentes)
RateLimiting__PublicSubmit__PermitLimit=30
RateLimiting__PublicSubmit__WindowSeconds=600
RateLimiting__PublicRead__PermitLimit=120
RateLimiting__PublicRead__WindowSeconds=60
RateLimiting__Login__PermitLimit=20
RateLimiting__Login__WindowSeconds=600

# Clés de protection des cookies du back-office : dossier persistant (volume Docker) en production
DataProtection__KeysPath=/var/lib/cse-forms/keys

# API : clé HMAC des défis anti-robot (preuve de travail) en base64 (32 octets) : `openssl rand -base64 32`.
# Ne jamais la versionner ; la changer invalide seulement les défis en cours (le navigateur en redemande un).
ProofOfWork__HmacKey=a-remplacer
# Difficulté (nombre maximal à chercher) et durée de validité d'un défi en minutes
ProofOfWork__MaxNumber=50000
ProofOfWork__ExpiresMinutes=20

# Stockage chiffré des PDF, hors de la racine web (volume Docker en production)
Storage__Path=/var/lib/cse-forms/files
# Clé AES-256 en base64 (32 octets) : générer avec `openssl rand -base64 32`, ne jamais la versionner.
# Sa perte rend les PDF illisibles : la sauvegarder à part des données.
Storage__EncryptionKey=a-remplacer

# Worker (PDF des réponses) et API (flyer) : conversion HTML vers PDF.
# Gotenberg reste sur le réseau interne, jamais exposé publiquement (docker-compose.dev.yml l'expose sur la boucle locale).
Gotenberg__Url=http://127.0.0.1:3000
GOTENBERG_PORT=3000
# Fréquence de relève des tâches (secondes) et nombre de tâches simultanées
Jobs__PollSeconds=5
Jobs__WorkerCount=2
# Worker : horaire de la purge des réponses échues (cron, heure de Paris ; par défaut chaque nuit à 3 h 17)
Purge__Cron=17 3 * * *

# Worker : identifiants SMTP (serveur, port, chiffrement et expéditeur se règlent dans les paramètres : settings set --key smtp.*)
# Laisser vides pour un relais sans authentification.
Smtp__Username=
Smtp__Password=
Smtp__TimeoutSeconds=30
