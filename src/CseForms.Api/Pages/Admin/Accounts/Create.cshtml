@page "/admin/comptes/nouveau"
@model CseForms.Api.Pages.Admin.Accounts.CreateModel
@{
    ViewData["Title"] = "Créer un compte";
}

<p><a href="/admin/comptes">Comptes des élus</a></p>
<h1>Créer un compte</h1>

@if (Model.TemporaryPassword is not null)
{
    <div class="notice" role="status"><p>Compte créé : @Model.Email.</p></div>
    <partial name="_TemporaryPassword" model="Model.TemporaryPassword" />
    <p><a href="/admin/comptes/@Model.CreatedId">Voir le compte</a> · <a href="/admin/comptes/nouveau">Créer un autre compte</a></p>
}
else
{
    @if (Model.Errors.Count > 0)
    {
        <div class="summary" role="alert">
            @foreach (var error in Model.Errors)
            {
                <p>@error</p>
            }
        </div>
    }

    <form method="post" class="card narrow">
        <div class="field">
            <label for="Email">Adresse email (identifiant de connexion)</label>
            <input id="Email" name="Email" type="email" value="@Model.Email" autocomplete="off" required>
        </div>
        <partial name="_AccountFields" model="Model.Fields" />
        <p class="help">Un mot de passe provisoire sera affiché une seule fois après la création.</p>
        <button type="submit" class="primary">Créer le compte</button>
    </form>
}
