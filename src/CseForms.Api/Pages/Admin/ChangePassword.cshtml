@page "/admin/mot-de-passe"
@model CseForms.Api.Pages.Admin.ChangePasswordModel
@{
    ViewData["Title"] = "Mot de passe";
}

<h1>Mot de passe</h1>

@if (Model.Required)
{
    <div class="notice" role="status">
        <p>Votre mot de passe est provisoire : choisissez-en un nouveau pour accéder au back-office.</p>
    </div>
}

@if (Model.Errors.Count > 0)
{
    <div class="summary" role="alert">
        @foreach (var error in Model.Errors)
        {
            <p>@error</p>
        }
    </div>
}

@if (Model.Message is not null)
{
    <div class="notice" role="status"><p>@Model.Message</p></div>
}

<form method="post" class="card narrow">
    <div class="field">
        <label for="CurrentPassword">Mot de passe actuel@(Model.Required ? " (provisoire)" : "")</label>
        <input id="CurrentPassword" name="CurrentPassword" type="password" autocomplete="current-password" required>
    </div>
    <div class="field">
        <label for="NewPassword">Nouveau mot de passe</label>
        <p class="help">@Model.MinimumLength caractères au moins. Une phrase de plusieurs mots est plus facile à retenir.</p>
        <input id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" minlength="@Model.MinimumLength" required>
    </div>
    <div class="field">
        <label for="Confirmation">Confirmation du nouveau mot de passe</label>
        <input id="Confirmation" name="Confirmation" type="password" autocomplete="new-password" minlength="@Model.MinimumLength" required>
    </div>
    <button type="submit" class="primary">Changer le mot de passe</button>
</form>
