@page "/admin/reponses/{id:guid}"
@model CseForms.Api.Pages.Admin.Submissions.DetailModel
@{
    var detail = Model.Detail;
    ViewData["Title"] = $"Dossier {detail.CaseNumber}";
}

<p><a href="/admin/formulaires/@detail.FormId/reponses">@detail.FormTitle</a></p>
<h1>Dossier @detail.CaseNumber</h1>

@if (Model.StatusMessage == "modifie")
{
    <div class="notice" role="status"><p>Statut enregistré : @SubmissionStatuses.Label(detail.Status).</p></div>
}

<dl class="card meta">
    <div><dt>Reçu le</dt><dd>@Display.DateTime(detail.CreatedAt)</dd></div>
    <div><dt>Statut</dt><dd>@SubmissionStatuses.Label(detail.Status)</dd></div>
    <div><dt>Version du formulaire</dt><dd>@detail.VersionNumber</dd></div>
    @if (detail.PurgeAt is { } purgeAt)
    {
        <div><dt>Suppression prévue le</dt><dd>@Display.Date(purgeAt)</dd></div>
    }
    else if (detail.RetentionDays is { } days)
    {
        <div><dt>Conservation</dt><dd>@days jours à partir du traitement</dd></div>
    }
</dl>

@if (Model.CanChangeStatus)
{
    <section class="card" aria-labelledby="status-title">
        <h2 id="status-title">Traitement</h2>
        <form method="post" asp-page-handler="Status" asp-route-id="@detail.Id" class="inline-form">
            <div class="field">
                <label for="status">Statut</label>
                <select id="status" name="status">
                    @foreach (var status in SubmissionStatuses.All)
                    {
                        <option value="@status" selected="@(status == detail.Status)">@SubmissionStatuses.Label(status)</option>
                    }
                </select>
            </div>
            <button type="submit" class="primary">Enregistrer le statut</button>
        </form>
        @if (detail.RetentionDays is { } retention)
        {
            <p>Dès que la réponse quitte le statut « @SubmissionStatuses.Label(SubmissionStatuses.New) », elle est conservée @retention jours puis supprimée avec son PDF. Revenir à « @SubmissionStatuses.Label(SubmissionStatuses.New) » annule la suppression prévue.</p>
        }
    </section>
}

<section class="card" aria-labelledby="pdf-title">
    <h2 id="pdf-title">PDF</h2>
    @if (detail.Pdf.Available)
    {
        <p>Généré le @Display.DateTime(detail.Pdf.GeneratedAt!.Value).
            <a href="/admin/reponses/@detail.Id/pdf">Télécharger le PDF</a> (téléchargement journalisé).</p>
    }
    @if (detail.Pdf.Generating)
    {
        <p role="status">@(detail.Pdf.Available ? "Nouvelle génération en cours." : "Génération en cours : rechargez la page dans quelques instants.")</p>
    }
    else if (detail.Pdf.Failed)
    {
        <p class="error-text" role="alert">La dernière génération a échoué. Vous pouvez la relancer.</p>
    }
    else if (!detail.Pdf.Available)
    {
        <p>Aucun PDF disponible.</p>
    }
    @if (Model.CanRegenerate && !detail.Pdf.Generating)
    {
        <form method="post" asp-page-handler="Regenerate" asp-route-id="@detail.Id">
            <button type="submit">Régénérer le PDF</button>
        </form>
    }
</section>

@foreach (var part in detail.Sections)
{
    <section class="card">
        @if (part.Title is not null)
        {
            <h2>@part.Title</h2>
        }
        @foreach (var item in part.Items)
        {
            if (item is PresentedValue value)
            {
                <dl class="values"><div><dt>@value.Label</dt><dd>@value.Value</dd></div></dl>
            }
            else if (item is PresentedTable table)
            {
                <h3>@table.Label</h3>
                <div class="table-wrap">
                    <table>
                        <thead><tr>@foreach (var header in table.Headers) { <th scope="col">@header</th> }</tr></thead>
                        <tbody>
                            @foreach (var row in table.Rows)
                            {
                                <tr>@foreach (var cell in row) { <td>@cell</td> }</tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </section>
}

<section class="card" aria-labelledby="history-title">
    <h2 id="history-title">Historique</h2>
    <ul class="history">
        @foreach (var entry in detail.History)
        {
            <li>
                <time datetime="@entry.At.ToString("o")">@Display.DateTime(entry.At)</time>
                @entry.Label
                @if (entry.Actor is not null)
                {
                    <span class="actor">par @entry.Actor</span>
                }
            </li>
        }
    </ul>
    <p>Les consultations de la fiche figurent dans le journal d'audit, pas dans cet historique.</p>
</section>

@if (Model.CanDelete)
{
    <p><a href="/admin/reponses/@detail.Id/suppression">Supprimer définitivement cette réponse</a></p>
}
