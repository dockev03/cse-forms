# Production (docker-compose.yml) : copier en .env sur le serveur (fichier exclu du dépôt, droits 600)
# et remplacer chaque valeur « a-remplacer ». Jamais de secret versionné.

# Version des images de l'API et du Worker publiées sur GHCR (tag vX.Y.Z sans le « v »).
# Toujours une version précise, jamais « latest » : les migrations ne se défont pas.
# Liste des versions : https://github.com/dockev03/cse-forms/releases (ou les tags du dépôt).
CSE_FORMS_VERSION=1.0.0
# Registre des images (facultatif) : à changer seulement pour un miroir interne.
# CSE_FORMS_REGISTRY=ghcr.io/dockev03

# PostgreSQL : le mot de passe ne doit contenir ni « ; » ni guillemet (il entre dans la chaîne de connexion).
# Générer avec : openssl rand -hex 24
POSTGRES_DB=cseforms
POSTGRES_USER=cseforms
POSTGRES_PASSWORD=a-remplacer

# Port HTTP publié de l'API, destiné au seul reverse proxy existant.
# API_BIND : adresse d'écoute sur l'hôte (0.0.0.0 = toutes ; la restreindre à l'interface joignable par le proxy si possible).
API_BIND=0.0.0.0
API_PORT=8080

# Adresse(s) du reverse proxy autorisée(s) à transmettre X-Forwarded-For/Proto, en CIDR séparés par des virgules.
# Obligatoire : sans elle, l'IP client et le HTTPS ne sont pas reconnus (connexion au back-office impossible).
# Mettre l'IP du proxy telle que vue par l'API, jamais un réseau large.
ReverseProxy__KnownNetworks=192.0.2.10/32

# Clé AES-256 des PDF en base64 (32 octets) : openssl rand -base64 32
# Sa perte rend les PDF illisibles : la sauvegarder à part des données.
Storage__EncryptionKey=a-remplacer

# Clé HMAC des défis anti-robot en base64 (32 octets) : openssl rand -base64 32
ProofOfWork__HmacKey=a-remplacer

# Administrateur initial du back-office, créé au premier démarrage si la base ne contient aucun compte
# (ignoré ensuite). Mot de passe de 12 caractères minimum, provisoire : il est à changer à la première
# connexion. Une fois connecté, vider BootstrapAdmin__Password ; les autres comptes se créent dans « Comptes ».
BootstrapAdmin__Email=admin-cse@example.test
BootstrapAdmin__Name=Administrateur CSE
BootstrapAdmin__Password=a-remplacer

# Identifiants SMTP du Worker (serveur, port et expéditeur se règlent par : settings set --key smtp.*).
# Laisser vides pour un relais sans authentification.
Smtp__Username=
Smtp__Password=

# Valeurs facultatives (défauts dans docker-compose.yml) :
# ProofOfWork__MaxNumber=50000
# ProofOfWork__ExpiresMinutes=20
# RateLimiting__PublicSubmit__PermitLimit=30
# RateLimiting__PublicSubmit__WindowSeconds=600
# RateLimiting__PublicRead__PermitLimit=120
# RateLimiting__PublicRead__WindowSeconds=60
# RateLimiting__Login__PermitLimit=20
# RateLimiting__Login__WindowSeconds=600
# Jobs__PollSeconds=5
# Jobs__WorkerCount=2
# Purge__Cron=17 3 * * *
# Smtp__TimeoutSeconds=30
