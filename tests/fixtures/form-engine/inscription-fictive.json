{
  "description": "Définition proche de la fiche d'inscription (specs.md section 4), données fictives",
  "today": "2026-10-30",
  "sites": ["Abrest", "Aulnat", "Riom"],
  "definition": {
    "sections": [
      {
        "id": "etatCivil",
        "title": "État civil",
        "fields": [
          { "id": "civilite", "type": "choice", "label": "Civilité", "required": true, "options": ["M.", "Mme"], "display": "radio" },
          { "id": "nom", "type": "text", "label": "Nom", "required": true, "transform": "upper", "maxLength": 80 },
          { "id": "prenom", "type": "text", "label": "Prénom", "required": true, "transform": "capitalize", "maxLength": 80 }
        ]
      },
      {
        "id": "pro",
        "title": "Informations professionnelles",
        "fields": [
          { "id": "contrat", "type": "choice", "label": "Type de contrat", "required": true, "options": ["CDI", "CDD", "Apprentissage", "Stage"] },
          { "id": "dateEmbauche", "type": "date", "label": "Date d'embauche", "required": true, "rules": [{ "op": "notAfter", "value": "today+6M" }] },
          {
            "id": "dateFin",
            "type": "date",
            "label": "Date de fin",
            "required": true,
            "visibleIf": { "field": "contrat", "op": "notEquals", "value": "CDI" },
            "rules": [{ "op": "after", "field": "dateEmbauche" }]
          },
          { "id": "site", "type": "site", "label": "Lieu de travail", "required": true, "prefill": "url" }
        ]
      },
      {
        "id": "coordonnees",
        "title": "Coordonnées",
        "fields": [
          { "id": "adresse", "type": "address", "label": "Adresse", "required": true },
          { "id": "emailPerso", "type": "email", "label": "Email personnel", "required": true },
          { "id": "emailConfirmation", "type": "email", "label": "Confirmation de l'email", "required": true, "persist": false, "rules": [{ "op": "sameAs", "field": "emailPerso" }] }
        ]
      },
      {
        "id": "conjoint",
        "title": "Conjoint",
        "collapsed": true,
        "fields": [
          { "id": "conjointNom", "type": "text", "label": "Nom du conjoint", "transform": "upper" },
          { "id": "conjointPrenom", "type": "text", "label": "Prénom du conjoint", "transform": "capitalize" }
        ]
      },
      {
        "id": "enfants",
        "title": "Enfants",
        "fields": [
          {
            "id": "enfants",
            "type": "repeat",
            "label": "Enfants",
            "max": 10,
            "addLabel": "Ajouter un enfant",
            "fields": [
              { "id": "nom", "type": "text", "label": "Nom", "required": true, "transform": "upper" },
              { "id": "prenom", "type": "text", "label": "Prénom", "required": true, "transform": "capitalize" },
              { "id": "naissance", "type": "date", "label": "Date de naissance", "required": true, "rules": [{ "op": "past" }] },
              { "id": "sexe", "type": "choice", "label": "Sexe", "options": ["F", "M"] }
            ]
          }
        ]
      },
      {
        "id": "validation",
        "title": "Validation",
        "fields": [
          { "id": "rgpdInfo", "type": "info", "text": "Notice d'information sur le traitement des données." },
          { "id": "rgpdLu", "type": "consent", "label": "J'ai lu la notice d'information", "required": true },
          { "id": "attestation", "type": "consent", "label": "J'atteste l'exactitude des informations", "required": true }
        ]
      }
    ]
  },
  "cases": [
    {
      "name": "CDI complet, normalisé, dateFin et champs inconnus ignorés",
