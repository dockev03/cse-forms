        { "path": "nom", "code": "required" },
        { "path": "prenom", "code": "required" },
        { "path": "contrat", "code": "required" },
        { "path": "dateEmbauche", "code": "required" },
        { "path": "dateFin", "code": "required" },
        { "path": "site", "code": "required" },
        { "path": "adresse", "code": "required" },
