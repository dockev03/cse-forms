        "emailPerso": " Camille.Dupont@Example.TEST ",
        "emailConfirmation": "camille.dupont@example.test",
        "enfants": [{ "nom": "dupont", "prenom": "léa", "naissance": "2020-05-01", "sexe": "F" }],
        "rgpdLu": true,
        "attestation": true,
        "champInconnu": "ignoré"
      },
      "errors": [],
      "data": {
