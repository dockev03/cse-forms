{
  "description": "Sauts vers une section ou une page de fin, sections hors parcours, sauts d'une section masquée ignorés",
  "today": "2026-11-15",
  "sites": ["Riom"],
  "definition": {
    "sections": [
      {
        "id": "eligibilite",
        "fields": [
          { "id": "salarie", "type": "choice", "label": "Êtes-vous salarié de l'entreprise ?", "required": true, "options": ["oui", "non"] }
        ],
        "jumps": [ { "if": { "field": "salarie", "op": "equals", "value": "non" }, "end": "nonEligible" } ]
      },
      {
        "id": "inscription",
        "fields": [
          { "id": "nom", "type": "text", "label": "Nom", "required": true, "transform": "upper" },
          { "id": "formule", "type": "choice", "label": "Formule", "required": true, "options": ["journee", "soiree"] }
        ],
        "jumps": [ { "if": { "field": "formule", "op": "equals", "value": "soiree" }, "goTo": "soiree" } ]
      },
      {
        "id": "journee",
        "fields": [
          { "id": "repas", "type": "choice", "label": "Repas sur place", "required": true, "options": ["oui", "non"] }
        ],
        "jumps": [ { "goTo": "fin" } ]
      },
      {
        "id": "soiree",
        "fields": [
          { "id": "accompagnant", "type": "choice", "label": "Venez-vous accompagné ?", "required": true, "options": ["oui", "non"] }
        ]
      },
      {
        "id": "accompagnement",
        "visibleIf": { "field": "accompagnant", "op": "equals", "value": "oui" },
        "fields": [
          { "id": "nomAccompagnant", "type": "text", "label": "Nom de l'accompagnant", "required": true, "transform": "upper" }
        ],
        "jumps": [ { "end": "attente" } ]
      },
      {
        "id": "fin",
        "fields": [
          { "id": "commentaire", "type": "textarea", "label": "Commentaire" }
        ]
      }
    ],
    "endings": [
      { "id": "nonEligible", "title": "Inscription réservée aux salariés", "text": "Cette sortie est réservée aux salariés de l'entreprise." },
      { "id": "attente", "title": "Vous êtes sur liste d'attente", "text": "Les places avec accompagnant sont attribuées après le 1er décembre." }
    ]
  },
  "cases": [
