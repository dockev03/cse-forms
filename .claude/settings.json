{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b feature/*)",
      "Bash(git checkout -b fix/*)",
      "Bash(git checkout -b docs/*)",
      "Bash(git push -u origin feature/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin docs/*)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push * staging)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  }
}
